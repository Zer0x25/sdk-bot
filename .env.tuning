# =============================================================================
# SDK-BOT — ARCHIVO DE TUNING CENTRALIZADO
# =============================================================================
# Este archivo centraliza TODAS las constantes "tunables" del bot para que
# puedas ajustarlas SIN tocar el código. Es versionable (NO está en .gitignore)
# y NO contiene secretos (las API keys viven en brain/.env, que SÍ es ignorado).
#
# Formato: CLAVE=valor  (sin espacios, sin comillas). Las líneas que empiezan
# con # son comentarios. Cualquier clave que dejes comentada/restaurada usa el
# default del código (anotado en cada bloque).
#
# El brain (Python) lo lee vía python-dotenv + config.py.
# El gateway (Node) lo lee con un mini-parser propio (gateway/tuning.js),
# sin instalar dependencias extra.
# =============================================================================


# -----------------------------------------------------------------------------
# 🧠 MEMORIA DE CONVERSACIÓN DEL BRAIN (apps/brain/memory.py)
# -----------------------------------------------------------------------------
# Ventana temporal del historial que el bot "recuerda" por chat.
#   Default original: 86400 (24 horas)
#   Valor activo: 604800 (7 días) — lo pediste así.
BRAIN_MEMORY_WINDOW_SECONDS=604800

# Máximo de mensajes de contexto entregados al modelo por turno.
#   0 o negativo = SIN límite de cantidad (se respeta solo el tope de tokens).
#   Default original: 15
#   Valor activo: 0 (sin límite de mensajes)
BRAIN_MEMORY_MAX_MESSAGES=0

# Techo duro de contexto en tokens aproximados (~chars/4). El recorte por
# tokens SIEMPRE se aplica y conserva el último intercambio.
#   Default original: 2000
#   Valor activo: 5000 — lo pediste así.
BRAIN_MEMORY_MAX_TOKENS=5000

# Barrido global de la DB de memoria cada N escrituras (limpia chats abandonados).
#   Default: 50
BRAIN_MEMORY_GLOBAL_SWEEP_EVERY=50


# -----------------------------------------------------------------------------
# 🧠 GATEWAY — PRECARGA DE HISTORIAL EN PRESENCIA (Opción A, "web-like")
# -----------------------------------------------------------------------------
# Al detectar que el cliente está escribiendo (composing), el gateway precarga el
# historial del chat (GET /history del brain) en RAM. Cuando el mensaje llega, ya
# está en cache y se pasa al brain sin esperar la consulta interna (señal de
# intervención similar a un cliente web). El dedup por TTL evita llamar al brain
# en cada evento de presencia.
#   GATEWAY_PRELOAD_ENABLED=1  -> activa la precarga (default 0 = comportamiento legacy)
#   GATEWAY_PRELOAD_TTL_MS    -> tiempo que el precargo caliente dura antes de refrescar (default 180000 = 3 min)
#   GATEWAY_PRELOAD_ONLY_DIRECT -> solo chats 1-a-1 (no grupos) por defecto (1; pon 0 para incluir grupos)
GATEWAY_PRELOAD_ENABLED=1
GATEWAY_PRELOAD_TTL_MS=180000
GATEWAY_PRELOAD_ONLY_DIRECT=1
# Fuente de la precarga en presencia (etapa 1, web-like):
#   'baileys' (default, Opción C) = hilo REAL desde el store RAM de Baileys
#     (lo que el web muestra al abrir el chat: tuyo + cliente + bot). On-demand
#     por chat, NO masivo.
#   'brain' (legacy) = va al brain SQLite (solo lo que el bot respondió).
GATEWAY_PRELOAD_SOURCE=baileys
# Límites de la precarga en presencia (ETAPA 1, "primera página" web-like).
# Son MENORES que los de respuesta: la precarga es solo señal de intervención
# (el bot "ya sabe de qué va" al abrir el chat) y NO se usa para contestar.
# /chat sigue usando el contexto COMPLETO (BRAIN_MEMORY_* = 7d / 5000 tok).
# Precarga por CANTIDAD de mensajes (igual que el web, que pagina por mensajes
# visibles, no por tokens). El tope de tokens se deja en 0: en la respuesta
# (etapa 2) ya lo gobierna BRAIN_MEMORY_MAX_TOKENS.
GATEWAY_PRELOAD_MAX_MESSAGES=25
GATEWAY_PRELOAD_MAX_TOKENS=0

# Opciones del store RAM de Baileys (Opción C). El store siembra el historial
# real desde messaging-history.set y lo actualiza con cada mensaje en vivo.
# Tope por chat en RAM y TTL de evicción para que 1000 contactos no exploten
# la memoria (cada chat tiene tope y los fríos se botan).
GATEWAY_PRELOAD_MAX_PER_CHAT=200
GATEWAY_PRELOAD_CHAT_TTL_MS=1800000
GATEWAY_PRELOAD_CLEANUP_MS=600000


# -----------------------------------------------------------------------------
# ⌨️ GATEWAY — DE-BOUNCE / PRESENCIA (apps/gateway/handlers/messageHandler.js)
# -----------------------------------------------------------------------------
# TTL del estado "escribiendo" si el evento paused no llega (default 5000 = 5s).
GATEWAY_TYPING_TTL_MS=5000

# Cada cuánto se limpia la RAM de presencias/buffers (default 600000 = 10 min).
GATEWAY_PRESENCE_CLEANUP_INTERVAL_MS=600000

# Edad máxima de un registro de presencia antes de descartarse (default 900000 = 15 min).
GATEWAY_PRESENCE_MAX_AGE_MS=900000

# Edad máxima de un buffer de mensajes huérfano antes de descartarse (default 900000 = 15 min).
GATEWAY_BUFFER_MAX_AGE_MS=900000


# -----------------------------------------------------------------------------
# 💾 GATEWAY — PERSISTENCIA (apps/gateway/services/db.js)
# -----------------------------------------------------------------------------
# Debounce de guardado en disco de contacts_db / settings_db (default 2000 = 2s).
GATEWAY_SAVE_DELAY_MS=2000


# -----------------------------------------------------------------------------
# 🎯 GATEWAY — POOL DE IA (apps/gateway/services/aiQueue.js)
# -----------------------------------------------------------------------------
# Máximo de llamadas a la IA en simultáneo (el resto espera en cola FIFO).
#   Default: 3
GATEWAY_AI_MAX_CONCURRENCY=3


# -----------------------------------------------------------------------------
# 📢 GATEWAY — BROADCAST (apps/gateway/services/broadcastService.js)
# -----------------------------------------------------------------------------
# Ventana para confirmar un broadcast con "si"/"cancelar" (default 60000 = 1 min).
GATEWAY_BROADCAST_CONFIRMATION_TTL_MS=60000


# -----------------------------------------------------------------------------
# 🔄 GATEWAY — METADATA (apps/gateway/services/metadataService.js)
# -----------------------------------------------------------------------------
# TTL de refresco de foto de perfil y bio de contactos (default 86400000 = 24h).
GATEWAY_TTL_ENRICHMENT_MS=86400000


# -----------------------------------------------------------------------------
# 🛡️ GATEWAY — COMANDOS ADMIN (apps/gateway/handlers/commandHandler.js)
# -----------------------------------------------------------------------------
# Límite de comandos admin por minuto por admin (ventana deslizante).
#   Default: 20
GATEWAY_ADMIN_CMD_MAX_PER_MIN=20


# -----------------------------------------------------------------------------
# 🖥️ GATEWAY — PANEL WEB (apps/gateway/services/internalBus.js)
# -----------------------------------------------------------------------------
# TTL del QR mostrado en el panel antes de expirar (default 140000 = 2 min 20 s).
GATEWAY_QR_TTL_MS=140000
# Ventana útil del código de enlace de 8 caracteres (default 180000 = 3 min).
# No es un TTL duro de WhatsApp: pasado este tiempo el panel avisa de que
# conviene pedir otro código.
GATEWAY_PAIRING_CODE_TTL_MS=180000
# Techo de espera al pedir el código de enlace (default 20000). Evita que una
# promesa colgada de Baileys deje bloqueado el flujo de pairing por número.
GATEWAY_PAIRING_CODE_TIMEOUT_MS=20000


# -----------------------------------------------------------------------------
# ⚙️ GATEWAY — CACHE DE PERFILES / ALERTAS (apps/gateway/services/brainService.js)
# -----------------------------------------------------------------------------
# Refresco de caché de perfiles del brain (default 60000 = 1 min).
GATEWAY_PROFILES_CACHE_TTL_MS=60000

# Throttle de alertas de "brain caído" (default 900000 = 15 min).
GATEWAY_BRAIN_ALERT_THROTTLE_MS=900000


# -----------------------------------------------------------------------------
# 🧠 PROVEEDORES / HUMANIZACIÓN (apps/brain/config.py + providers.py)
# -----------------------------------------------------------------------------
# Orden de la cascada de IA. Valores: gemini | groq | openrouter.
#   Default: gemini  (Gemini 3.1 Flash Lite como primary; Groq/OpenRouter fallback)
BRAIN_PRIMARY_MODEL=gemini

# Modelo de Gemini a usar cuando es el primary (o fallback).
#   Default: gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite

# Timeouts por proveedor en segundos (antes hardcodeados en 25/25/40).
#   Default Groq/OpenRouter: 25   Gemini: 40
BRAIN_TIMEOUT_GROQ=25
BRAIN_TIMEOUT_OPENROUTER=25
BRAIN_TIMEOUT_GEMINI=40

# Ventana del rate-limit de /chat en segundos (antes hardcodeada en 60.0).
#   Default: 60
BRAIN_RATE_LIMIT_WINDOW=60

# 🎚️ MUESTREO / "VOZ" DEL BOT (capa de imitación humana).
# temperatura 0 = determinista, ~0.7 natural, ~1.0 creativo.
#   Default: 0.7
BRAIN_TEMPERATURE=0.7
# top_p (núcleo de probabilidad). 0.9 = diverso pero coherente.
#   Default: 0.9
BRAIN_TOP_P=0.9
# Tope duro de tokens de SALIDA. 0 = sin límite (lo gobierna el modelo).
#   Para respuestas cortas tipo WhatsApp, probar 300-600.
#   Default: 0 (sin tope)
BRAIN_MAX_OUTPUT_TOKENS=0

# 🎤 STT LOCAL (faster-whisper, paquete apps/stt/ del repo)
# Activa la transcripción de audios de WhatsApp/Telegram a texto.
#   0 = desactivado (el bot ignora audios, comportamiento legacy)
#   1 = activado (gateway descarga el audio y lo manda al servicio stt)
# El servicio corre local/detrás de Docker internal net; no se expone a internet.
AUDIO_STT_ENABLED=1
# URL del servicio STT (OpenAI-compatible). En dev local apunta a :9000;
# en Docker lo resuelve el service "stt" (http://stt:9000). Override con STT_API_URL.
#STT_API_URL=http://127.0.0.1:9000
# Modelo de faster-whisper: base (rápido en CPU) | small (mejor accuracy, más CPU)
#   Se fija en STT_MODEL del env del container stt (ver compose.yml / stt.Dockerfile).
# Idioma forzado para acelerar y mejorar accuracy (es = español). Vacío = auto-detect.
#STT_LANGUAGE=es
# Tope de espera por audio (ms). La transcripción en CPU puede tardar; 60s cubre cortos.
STT_TIMEOUT_MS=60000
# Tope de duración de audio aceptado (segundos). > esto se rechaza con aviso al usuario.
STT_MAX_SECONDS=120
# Tope de tamaño de audio subido al servicio (bytes). ~5 MB cubre 2 min opus.
STT_MAX_UPLOAD_BYTES=5242880

# Estilo global de "imitación humana" inyectado en TODOS los perfiles (rol
# aparte). Edítalo para afinar la voz sin tocar cada profiles/*.md.
#   Default: tono WhatsApp corto/cálido, ≤1 emoji, saltos de línea, idioma del cliente.
BRAIN_STYLE_GLOBAL=Hablar como un humano real por WhatsApp: mensajes cortos y cálidos, un solo emoji como mucho por globo, saltos de línea para separar ideas, y sin sonar robótico ni como manual de instrucciones. Responder en el idioma del cliente.


# -----------------------------------------------------------------------------
# 🎭 SIMULACIÓN HUMANA / AFK (apps/gateway/services/humanSim.js + pipeline.js)
# -----------------------------------------------------------------------------
# Tamaño objetivo máximo por globo de chat (chars). Respuestas más largas se
# dividen en varios globos naturales. Bajar a ~140 para globos tipo teléfono.
#   Default: 220
GATEWAY_BUBBLE_MAX_CHARS=220

# Tiempo de "leyendo/pensando" antes de empezar a teclear (ms).
#   base = clamp(len*mult, MIN, MAX) + jitter ±(JITTER/2)
#   Default: MIN 1000, MAX 3000, JITTER 600 (±300), mult implícito 15/char
GATEWAY_READ_DELAY_MIN_MS=1000
GATEWAY_READ_DELAY_MAX_MS=3000
GATEWAY_READ_DELAY_JITTER_MS=600

# Velocidad de tecleo: ms por carácter (rango). Móvil rápido ~7-10 char/s.
#   Default: 100..135 ms/char, clamp global 1500..16000, jitter ±500
GATEWAY_TYPING_MS_PER_CHAR_MIN=100
GATEWAY_TYPING_MS_PER_CHAR_MAX=135
GATEWAY_TYPING_MIN_MS=1500
GATEWAY_TYPING_MAX_MS=16000
GATEWAY_TYPING_JITTER_MS=1000

# Pausa humana entre globos consecutivos (ms).
#   Default: 1000..2200
GATEWAY_PAUSE_BETWEEN_BUBBLES_MIN_MS=1000
GATEWAY_PAUSE_BETWEEN_BUBBLES_MAX_MS=2200

# 🎲 Distracción/Ocupación (AFK) — el bot "no responde de inmediato" como
# un humano ocupado (sin avisar; solo demora). Probabilidades acumulativas.
#   Capa 1 (AFK_PROB): muy ocupado -> espera AFK_MIN..AFK_MAX
#   Capa 2 (BUSY_PROB): ocupado breve -> espera BUSY_MIN..BUSY_MAX
#   Capa 3 (resto): adaptativo por longitud del mensaje
#   Defaults: AFK 5% (180000..240000ms = 3-4 min), BUSY 12% (60000..120000 = 1-2 min)
GATEWAY_AFK_PROB=0.03
GATEWAY_AFK_MIN_MS=180000
GATEWAY_AFK_MAX_MS=240000
GATEWAY_BUSY_PROB=0.10
GATEWAY_BUSY_MIN_MS=60000
GATEWAY_BUSY_MAX_MS=90000

# Adaptativo normal (~resto de los rolls): demora según longitud del mensaje.
#   Mensaje corto único (< NORMAL_SHORT_MAX_LEN chars): NORMAL_SHORT_MIN..MAX
#   Largo/múltiple: NORMAL_LONG_MIN..MAX
#   Defaults: corto 5000..7000 (5-7s), largo 7500..12000 (7.5-12s), tope 20 chars
GATEWAY_NORMAL_SHORT_MIN_MS=5000
GATEWAY_NORMAL_SHORT_MAX_MS=7000
GATEWAY_NORMAL_SHORT_MAX_LEN=30
GATEWAY_NORMAL_LONG_MIN_MS=7500
GATEWAY_NORMAL_LONG_MAX_MS=12000
