# =============================================================================
# SDK-BOT — ARCHIVO DE TUNING CENTRALIZADO
# =============================================================================
# Este archivo centraliza TODAS las constantes "tunables" del bot para que
# puedas ajustarlas SIN tocar el código. Es versionable (NO está en .gitignore)
# y NO contiene secretos (las API keys viven en brain/.env, que SÍ es ignorado).
#
# Formato: CLAVE=valor  (sin espacios, sin comillas). Las líneas que empiezan
# con # son comentarios. Cualquier clave que dejes comentada/restaurada usa el
# default del código (anotado en cada bloque).
#
# El brain (Python) lo lee vía python-dotenv + config.py.
# El gateway (Node) lo lee con un mini-parser propio (gateway/tuning.js),
# sin instalar dependencias extra.
# =============================================================================


# -----------------------------------------------------------------------------
# 🧠 MEMORIA DE CONVERSACIÓN DEL BRAIN (brain/memory.py)
# -----------------------------------------------------------------------------
# Ventana temporal del historial que el bot "recuerda" por chat.
#   Default original: 86400 (24 horas)
#   Valor activo: 604800 (7 días) — lo pediste así.
BRAIN_MEMORY_WINDOW_SECONDS=604800

# Máximo de mensajes de contexto entregados al modelo por turno.
#   0 o negativo = SIN límite de cantidad (se respeta solo el tope de tokens).
#   Default original: 15
#   Valor activo: 0 (sin límite de mensajes)
BRAIN_MEMORY_MAX_MESSAGES=0

# Techo duro de contexto en tokens aproximados (~chars/4). El recorte por
# tokens SIEMPRE se aplica y conserva el último intercambio.
#   Default original: 2000
#   Valor activo: 5000 — lo pediste así.
BRAIN_MEMORY_MAX_TOKENS=5000

# Barrido global de la DB de memoria cada N escrituras (limpia chats abandonados).
#   Default: 50
BRAIN_MEMORY_GLOBAL_SWEEP_EVERY=50


# -----------------------------------------------------------------------------
# 🧠 GATEWAY — PRECARGA DE HISTORIAL EN PRESENCIA (Opción A, "web-like")
# -----------------------------------------------------------------------------
# Al detectar que el cliente está escribiendo (composing), el gateway precarga el
# historial del chat (GET /history del brain) en RAM. Cuando el mensaje llega, ya
# está en cache y se pasa al brain sin esperar la consulta interna (señal de
# intervención similar a un cliente web). El dedup por TTL evita llamar al brain
# en cada evento de presencia.
#   GATEWAY_PRELOAD_ENABLED=1  -> activa la precarga (default 0 = comportamiento legacy)
#   GATEWAY_PRELOAD_TTL_MS    -> tiempo que el precargo caliente dura antes de refrescar (default 180000 = 3 min)
#   GATEWAY_PRELOAD_ONLY_DIRECT -> solo chats 1-a-1 (no grupos) por defecto (1; pon 0 para incluir grupos)
GATEWAY_PRELOAD_ENABLED=1
GATEWAY_PRELOAD_TTL_MS=180000
GATEWAY_PRELOAD_ONLY_DIRECT=1
# Fuente de la precarga en presencia (etapa 1, web-like):
#   'baileys' (default, Opción C) = hilo REAL desde el store RAM de Baileys
#     (lo que el web muestra al abrir el chat: tuyo + cliente + bot). On-demand
#     por chat, NO masivo.
#   'brain' (legacy) = va al brain SQLite (solo lo que el bot respondió).
GATEWAY_PRELOAD_SOURCE=baileys
# Límites de la precarga en presencia (ETAPA 1, "primera página" web-like).
# Son MENORES que los de respuesta: la precarga es solo señal de intervención
# (el bot "ya sabe de qué va" al abrir el chat) y NO se usa para contestar.
# /chat sigue usando el contexto COMPLETO (BRAIN_MEMORY_* = 7d / 5000 tok).
# Precarga por CANTIDAD de mensajes (igual que el web, que pagina por mensajes
# visibles, no por tokens). El tope de tokens se deja en 0: en la respuesta
# (etapa 2) ya lo gobierna BRAIN_MEMORY_MAX_TOKENS.
GATEWAY_PRELOAD_MAX_MESSAGES=25
GATEWAY_PRELOAD_MAX_TOKENS=0

# Opciones del store RAM de Baileys (Opción C). El store siembra el historial
# real desde messaging-history.set y lo actualiza con cada mensaje en vivo.
# Tope por chat en RAM y TTL de evicción para que 1000 contactos no exploten
# la memoria (cada chat tiene tope y los fríos se botan).
GATEWAY_PRELOAD_MAX_PER_CHAT=200
GATEWAY_PRELOAD_CHAT_TTL_MS=1800000
GATEWAY_PRELOAD_CLEANUP_MS=600000


# -----------------------------------------------------------------------------
# ⌨️ GATEWAY — DE-BOUNCE / PRESENCIA (gateway/handlers/messageHandler.js)
# -----------------------------------------------------------------------------
# TTL del estado "escribiendo" si el evento paused no llega (default 5000 = 5s).
GATEWAY_TYPING_TTL_MS=5000

# Cada cuánto se limpia la RAM de presencias/buffers (default 600000 = 10 min).
GATEWAY_PRESENCE_CLEANUP_INTERVAL_MS=600000

# Edad máxima de un registro de presencia antes de descartarse (default 900000 = 15 min).
GATEWAY_PRESENCE_MAX_AGE_MS=900000

# Edad máxima de un buffer de mensajes huérfano antes de descartarse (default 900000 = 15 min).
GATEWAY_BUFFER_MAX_AGE_MS=900000


# -----------------------------------------------------------------------------
# 💾 GATEWAY — PERSISTENCIA (gateway/services/db.js)
# -----------------------------------------------------------------------------
# Debounce de guardado en disco de contacts_db / settings_db (default 2000 = 2s).
GATEWAY_SAVE_DELAY_MS=2000


# -----------------------------------------------------------------------------
# 🎯 GATEWAY — POOL DE IA (gateway/services/aiQueue.js)
# -----------------------------------------------------------------------------
# Máximo de llamadas a la IA en simultáneo (el resto espera en cola FIFO).
#   Default: 3
GATEWAY_AI_MAX_CONCURRENCY=3


# -----------------------------------------------------------------------------
# 📢 GATEWAY — BROADCAST (gateway/services/broadcastService.js)
# -----------------------------------------------------------------------------
# Ventana para confirmar un broadcast con "si"/"cancelar" (default 60000 = 1 min).
GATEWAY_BROADCAST_CONFIRMATION_TTL_MS=60000


# -----------------------------------------------------------------------------
# 🔄 GATEWAY — METADATA (gateway/services/metadataService.js)
# -----------------------------------------------------------------------------
# TTL de refresco de foto de perfil y bio de contactos (default 86400000 = 24h).
GATEWAY_TTL_ENRICHMENT_MS=86400000


# -----------------------------------------------------------------------------
# 🛡️ GATEWAY — COMANDOS ADMIN (gateway/handlers/commandHandler.js)
# -----------------------------------------------------------------------------
# Límite de comandos admin por minuto por admin (ventana deslizante).
#   Default: 20
GATEWAY_ADMIN_CMD_MAX_PER_MIN=20


# -----------------------------------------------------------------------------
# 🖥️ GATEWAY — PANEL WEB (gateway/services/adminWebServer.js)
# -----------------------------------------------------------------------------
# TTL del QR mostrado en el panel antes de expirar (default 60000 = 1 min).
GATEWAY_QR_TTL_MS=60000


# -----------------------------------------------------------------------------
# ⚙️ GATEWAY — CACHE DE PERFILES / ALERTAS (gateway/services/brainService.js)
# -----------------------------------------------------------------------------
# Refresco de caché de perfiles del brain (default 60000 = 1 min).
GATEWAY_PROFILES_CACHE_TTL_MS=60000

# Throttle de alertas de "brain caído" (default 900000 = 15 min).
GATEWAY_BRAIN_ALERT_THROTTLE_MS=900000
