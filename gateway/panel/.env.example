# SDK-Bot Panel — OAuth Google (copia a .env y completa los valores; .env está en .gitignore)
# Credenciales del "ID de cliente de OAuth" (Aplicación web) en Google Cloud Console.
PANEL_GOOGLE_CLIENT_ID=
PANEL_GOOGLE_CLIENT_SECRET=
# Secret fijo para firmar la cookie de sesión (genera uno: openssl rand -hex 32).
# Si lo dejas vacío se genera uno efímero por arranque (sesiones se invalidan al reiniciar).
PANEL_SESSION_SECRET=
# Opcional: restringe a estos correos (csv, minúsculas). Vacío = cualquier cuenta Google verificada.
PANEL_ALLOWED_EMAILS=
# URL canónica pública del panel. DEBE coincidir con el redirect_uri autorizado en Google
# (p.ej. https://panel.zer0x.org) para que el OAuth no falle al entrar por IP/Tailscale.
PANEL_PUBLIC_URL=https://panel.zer0x.org

# Frontera panel -> gateway: secreto DISTINTO de cookie y claves IA, >=32 bytes.
# Debe llegar a AMBOS procesos; panel/.env solo lo carga el panel.
# Compose lo recibe del entorno de compose, no del env_file del contenedor.
SDK_PANEL_GATEWAY_SECRET=
# Solo desarrollo, opt-in local (nunca publicar este modo):
PANEL_DEV_ACTOR=false
# Grants por identidad Google estable, no por correo. Omisión = lectura v1;
# las rutas y la UI legacy requieren además admin:write explícito.
# Dev usa la clave dev:local. [] revoca todo acceso v1 y legacy. Ejemplo:
# PANEL_ACTOR_GRANTS={"google:123456":["conversations:read","messages:send","control:write","conversations:write","admin:write"]}
PANEL_ACTOR_GRANTS={}
