{
  "name": "gateway",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "reset": "node reset-session.js",
    "clean": "node reset-clean.js",
    "test": "SDK_BOT_TEST=1 node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p jsconfig.json",
    "panel:typecheck": "tsc -p panel/web/tsconfig.json",
    "panel:test": "vitest run --config panel/web/vite.config.mts",
    "panel:build": "vite build --config panel/web/vite.config.mts",
    "panel:check": "npm run panel:typecheck && npm run panel:test && npm run panel:build && node --test tests/panelWebBuild.test.js",
    "spike:sqlite": "node scripts/sqlite-spike.js",
    "conversations:control-dry-run": "node scripts/control-import-dry-run.js",
    "bench:conversations": "node scripts/conversation-load.js --full",
    "check": "npm run lint && npm run typecheck && npm run panel:check && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "WhatsApp Multi-Bot Gateway with Smart Sync & Metadata",
  "dependencies": {
    "@sdk-bot/contracts": "file:../packages/contracts",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.8.1",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
