{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk-bot.local/contracts/v1/schema.json",
  "title": "SDK-Bot v1 wire contracts",
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUID interno canónico en minúsculas; nunca ID numérico de proveedor."
    },
    "Sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "Decimal canónico como texto; sin Number. Secuencia 0 es watermark inicial."
    },
    "Version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "description": "Versión positiva decimal como texto. No intercambiar controlVersion con aggregateVersion."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "RFC3339 UTC con Z."
    },
    "Channel": {
      "type": "string",
      "enum": [
        "whatsapp",
        "telegram"
      ]
    },
    "AccessPolicy": {
      "type": "string",
      "enum": [
        "allowed",
        "ignored",
        "neutral"
      ]
    },
    "AutomationMode": {
      "type": "string",
      "enum": [
        "ai",
        "human",
        "off"
      ]
    },
    "Lifecycle": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ]
    },
    "TelegramChatId": {
      "type": "string",
      "pattern": "^-?[1-9][0-9]*$",
      "description": "ID exacto con signo y precisión arbitraria; validar tipo private en adapter, no por signo."
    },
    "ProviderMessageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "PageCursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Opaco, ligado a epoch/ámbito/filtros/orden. Su contenido se valida en servidor."
    },
    "PageLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 50
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$",
      "description": "Intención única por actor/cuenta/chat; no contiene secretos ni cuerpo."
    },
    "Capability": {
      "type": "string",
      "enum": [
        "conversations:read",
        "messages:send",
        "control:write",
        "control:override",
        "conversations:write"
      ]
    },
    "Actor": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "format": "unicode-text"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "displayName",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "ChannelCapabilities": {
      "type": "object",
      "properties": {
        "historySync": {
          "type": "boolean"
        },
        "attachments": {
          "type": "boolean"
        },
        "reply": {
          "type": "boolean"
        },
        "edit": {
          "type": "boolean"
        },
        "deliveryReceipt": {
          "type": "boolean"
        },
        "readReceipt": {
          "type": "boolean"
        }
      },
      "required": [
        "historySync",
        "attachments",
        "reply",
        "edit",
        "deliveryReceipt",
        "readReceipt"
      ],
      "additionalProperties": false
    },
    "Account": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "displayName": {
          "type": "string",
          "maxLength": 200,
          "format": "unicode-text"
        },
        "status": {
          "$ref": "#/$defs/AccountStatus"
        },
        "capabilities": {
          "$ref": "#/$defs/ChannelCapabilities"
        }
      },
      "required": [
        "id",
        "channel",
        "displayName",
        "status",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "IdentityKey": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accountId": {
              "$ref": "#/$defs/Id"
            },
            "channel": {
              "const": "telegram",
              "type": "string"
            },
            "kind": {
              "const": "telegram_chat_id",
              "type": "string"
            },
            "exactValue": {
              "$ref": "#/$defs/TelegramChatId"
            }
          },
          "required": [
            "accountId",
            "channel",
            "kind",
            "exactValue"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "$ref": "#/$defs/Id"
            },
            "channel": {
              "const": "whatsapp",
              "type": "string"
            },
            "kind": {
              "const": "whatsapp_jid",
              "type": "string"
            },
            "exactValue": {
              "type": "string",
              "pattern": "^[0-9]+@s\\.whatsapp\\.net$",
              "maxLength": 256
            }
          },
          "required": [
            "accountId",
            "channel",
            "kind",
            "exactValue"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "$ref": "#/$defs/Id"
            },
            "channel": {
              "const": "whatsapp",
              "type": "string"
            },
            "kind": {
              "const": "whatsapp_lid",
              "type": "string"
            },
            "exactValue": {
              "type": "string",
              "pattern": "^[0-9]+@lid$",
              "maxLength": 256
            }
          },
          "required": [
            "accountId",
            "channel",
            "kind",
            "exactValue"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "$ref": "#/$defs/Id"
            },
            "channel": {
              "const": "whatsapp",
              "type": "string"
            },
            "kind": {
              "const": "phone",
              "type": "string"
            },
            "exactValue": {
              "type": "string",
              "pattern": "^\\+[1-9][0-9]{1,14}$"
            }
          },
          "required": [
            "accountId",
            "channel",
            "kind",
            "exactValue"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Unicidad exacta (accountId,kind,exactValue). Ningún matcher parcial."
    },
    "Identity": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "contactId": {
          "$ref": "#/$defs/Id"
        },
        "canonicalIdentityId": {
          "$ref": "#/$defs/Id"
        },
        "key": {
          "$ref": "#/$defs/IdentityKey"
        },
        "verification": {
          "type": "string",
          "enum": [
            "adapter",
            "admin_review"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "resolved",
            "conflict",
            "requires_review"
          ]
        }
      },
      "required": [
        "id",
        "contactId",
        "canonicalIdentityId",
        "key",
        "verification",
        "resolution"
      ],
      "additionalProperties": false
    },
    "Contact": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200,
              "format": "unicode-text"
            },
            {
              "type": "null"
            }
          ]
        },
        "identities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identity"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "displayName",
        "identities"
      ],
      "additionalProperties": false
    },
    "DeduplicationKey": {
      "type": "object",
      "properties": {
        "accountId": {
          "$ref": "#/$defs/Id"
        },
        "canonicalIdentityId": {
          "$ref": "#/$defs/Id"
        },
        "providerMessageId": {
          "$ref": "#/$defs/ProviderMessageId"
        }
      },
      "required": [
        "accountId",
        "canonicalIdentityId",
        "providerMessageId"
      ],
      "additionalProperties": false,
      "description": "Solo con providerMessageId conocido; rawChatId es procedencia, no clave. La unión verificada reindexa en transacción."
    },
    "HistoryCoverage": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "capturing_since",
            "partial_import",
            "provider_sync_observed"
          ]
        },
        "capturingSince": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "capturingSince"
      ],
      "additionalProperties": false,
      "description": "Nunca certifica historial completo del proveedor."
    },
    "ConversationControl": {
      "type": "object",
      "properties": {
        "accessPolicy": {
          "$ref": "#/$defs/AccessPolicy"
        },
        "automationMode": {
          "$ref": "#/$defs/AutomationMode"
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle"
        },
        "ownerId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "controlVersion": {
          "$ref": "#/$defs/Version"
        },
        "contextVersion": {
          "$ref": "#/$defs/Version"
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "taking_control"
          ]
        },
        "takenAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "handoffReason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "operator",
                "customer_request",
                "external_self",
                "legacy_import",
                "identity_conflict"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "profileKey": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
            { "type": "null" }
          ]
        },
        "requiresReview": {
          "type": "boolean"
        },
        "reviewReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "invalid_legacy_state",
              "invalid_profile_key",
              "profile_inventory_unavailable",
              "profile_missing"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "accessPolicy",
        "automationMode",
        "lifecycle",
        "ownerId",
        "controlVersion",
        "contextVersion",
        "status",
        "takenAt",
        "handoffReason",
        "profileKey",
        "requiresReview",
        "reviewReasons"
      ],
      "additionalProperties": false,
      "description": "Forma de proyección; elegibilidad/cancelación/barrera se verifican en servicio de dominio F5."
    },
    "Conversation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "accountId": {
          "$ref": "#/$defs/Id"
        },
        "contactId": {
          "$ref": "#/$defs/Id"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200,
              "format": "unicode-text"
            },
            {
              "type": "null"
            }
          ]
        },
        "canonicalIdentityId": {
          "$ref": "#/$defs/Id"
        },
        "control": {
          "$ref": "#/$defs/ConversationControl"
        },
        "aggregateVersion": {
          "$ref": "#/$defs/Version"
        },
        "lastActivityAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "historyCoverage": {
          "$ref": "#/$defs/HistoryCoverage"
        },
        "unreadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requiresReview": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "accountId",
        "contactId",
        "canonicalIdentityId",
        "control",
        "aggregateVersion",
        "lastActivityAt",
        "historyCoverage",
        "unreadCount",
        "requiresReview"
      ],
      "additionalProperties": false
    },
    "GlobalPolicy": {
      "type": "object",
      "properties": {
        "globalMode": {
          "type": "string",
          "enum": [
            "allowed_all",
            "ignored_all"
          ]
        },
        "globalPaused": {
          "type": "boolean"
        },
        "policyVersion": {
          "$ref": "#/$defs/Version"
        }
      },
      "required": [
        "globalMode",
        "globalPaused",
        "policyVersion"
      ],
      "additionalProperties": false
    },
    "EventCursor": {
      "type": "object",
      "properties": {
        "dataEpoch": {
          "$ref": "#/$defs/Id"
        },
        "seq": {
          "$ref": "#/$defs/Sequence"
        }
      },
      "required": [
        "dataEpoch",
        "seq"
      ],
      "additionalProperties": false,
      "description": "Secuencia global no necesariamente consecutiva. Epoch distinto requiere snapshot nuevo."
    },
    "EventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}:(0|[1-9][0-9]*)$",
      "description": "SSE id y Last-Event-ID: dataEpoch:seq."
    },
    "OutgoingText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S",
      "format": "unicode-text",
      "x-maxUtf8Bytes": 16384,
      "description": "Texto literal; puntos de código Unicode, no unidades UTF16. No comandos/Markdown implícitos."
    },
    "StoredText": {
      "type": "string",
      "maxLength": 65536,
      "format": "unicode-text",
      "x-maxUtf8Bytes": 65536
    },
    "MessageContent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            },
            "text": {
              "$ref": "#/$defs/StoredText"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "audio",
                "image",
                "video",
                "document",
                "unsupported"
              ]
            },
            "availability": {
              "type": "string",
              "enum": [
                "not_stored",
                "available",
                "expired",
                "failed"
              ]
            },
            "transcript": {
              "anyOf": [
                {
                  "$ref": "#/$defs/StoredText"
                },
                {
                  "type": "null"
                }
              ]
            },
            "transcriptionStatus": {
              "type": "string",
              "enum": [
                "not_requested",
                "pending",
                "completed",
                "failed"
              ]
            },
            "caption": {
              "$ref": "#/$defs/StoredText",
              "description": "Texto adjunto literal; opcional para compatibilidad con marcadores anteriores."
            }
          },
          "required": [
            "type",
            "availability",
            "transcript",
            "transcriptionStatus"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "oversized",
              "type": "string"
            },
            "originalBytes": {
              "type": "integer",
              "minimum": 65537,
              "maximum": 9007199254740991
            },
            "reason": {
              "const": "text_limit",
              "type": "string"
            }
          },
          "required": [
            "type",
            "originalBytes",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "DeliveryStatus": {
      "type": "string",
      "enum": [
        "received",
        "queued",
        "sending",
        "sent",
        "delivered",
        "read",
        "failed",
        "delivery_unknown",
        "cancelled"
      ]
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "conversationId": {
          "$ref": "#/$defs/Id"
        },
        "providerMessageId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderMessageId"
            },
            {
              "type": "null"
            }
          ]
        },
        "clientMessageId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "inboundSeq": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sequence"
            },
            {
              "type": "null"
            }
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "inbound",
            "outbound"
          ]
        },
        "authorKind": {
          "type": "string",
          "enum": [
            "customer",
            "ai",
            "operator",
            "external_self",
            "system",
            "unknown"
          ]
        },
        "actorId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "$ref": "#/$defs/MessageContent"
        },
        "occurredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "ingestedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "deliveryStatus": {
          "$ref": "#/$defs/DeliveryStatus"
        },
        "replyToId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "live",
            "history",
            "panel",
            "automation",
            "command",
            "import"
          ]
        },
        "deduplicationQuality": {
          "type": "string",
          "enum": [
            "provider_id",
            "unknown"
          ]
        }
      },
      "required": [
        "id",
        "conversationId",
        "providerMessageId",
        "clientMessageId",
        "inboundSeq",
        "direction",
        "authorKind",
        "actorId",
        "content",
        "occurredAt",
        "ingestedAt",
        "deliveryStatus",
        "replyToId",
        "source",
        "deduplicationQuality"
      ],
      "additionalProperties": false
    },
    "ConversationsQuery": {
      "type": "object",
      "properties": {
        "cursor": {
          "$ref": "#/$defs/PageCursor"
        },
        "limit": {
          "$ref": "#/$defs/PageLimit"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "accountId": {
          "$ref": "#/$defs/Id"
        },
        "automationMode": {
          "$ref": "#/$defs/AutomationMode"
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle"
        },
        "unreadOnly": {
          "type": "boolean"
        },
        "search": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "format": "unicode-text"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "SummaryQuery": {
      "type": "object",
      "properties": {
        "from": { "$ref": "#/$defs/Timestamp" },
        "to": { "$ref": "#/$defs/Timestamp" }
      },
      "required": ["from", "to"],
      "additionalProperties": false
    },
    "SummaryChannelMetrics": {
      "type": "object",
      "properties": {
        "channel": { "$ref": "#/$defs/Channel" },
        "inboundMessages": { "type": "integer", "minimum": 0 },
        "activeConversations": { "type": "integer", "minimum": 0, "description": "Conversaciones con al menos una entrada durante el intervalo." },
        "acceptedAiReplies": { "type": "integer", "minimum": 0 },
        "acceptedHumanReplies": { "type": "integer", "minimum": 0 }
      },
      "required": ["channel", "inboundMessages", "activeConversations", "acceptedAiReplies", "acceptedHumanReplies"],
      "additionalProperties": false
    },
    "SummaryResponse": {
      "type": "object",
      "properties": {
        "period": {
          "type": "object",
          "properties": {
            "from": { "$ref": "#/$defs/Timestamp" },
            "to": { "$ref": "#/$defs/Timestamp" },
            "interval": { "const": "[from,to)" }
          },
          "required": ["from", "to", "interval"],
          "additionalProperties": false
        },
        "coverageStartAt": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "metrics": {
          "type": "object",
          "properties": {
            "inboundMessages": { "type": "integer", "minimum": 0 },
            "activeConversations": { "type": "integer", "minimum": 0, "description": "Conversaciones con al menos una entrada durante el intervalo." },
            "acceptedAiReplies": { "type": "integer", "minimum": 0 },
            "acceptedHumanReplies": { "type": "integer", "minimum": 0 }
          },
          "required": ["inboundMessages", "activeConversations", "acceptedAiReplies", "acceptedHumanReplies"],
          "additionalProperties": false
        },
        "byChannel": { "type": "array", "items": { "$ref": "#/$defs/SummaryChannelMetrics" }, "maxItems": 2 },
        "snapshot": { "$ref": "#/$defs/EventCursor" }
      },
      "required": ["period", "coverageStartAt", "metrics", "byChannel", "snapshot"],
      "additionalProperties": false
    },
    "MessagesQuery": {
      "type": "object",
      "properties": {
        "cursor": {
          "$ref": "#/$defs/PageCursor"
        },
        "limit": {
          "$ref": "#/$defs/PageLimit"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "SessionResponse": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "policy": {
          "$ref": "#/$defs/GlobalPolicy"
