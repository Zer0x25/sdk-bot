# systemd USER-unit legacy del Gateway (Node.js + Baileys). La producción documentada usa Docker Compose.
# Instalación:
#   cp sdk-bot-gateway.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now sdk-bot-gateway
# (Sin sudo: todo el homelab corre en systemd --user + linger del usuario zrx1)
#
# El Gateway se reinicia tras cada caída (Restart=always) y hace
# reconexión propia a WhatsApp con backoff exponencial (2s→60s).
# NO uses `--restart` aquí: ese flag es para reinicios manuales.

[Unit]
Description=SDK-Bot Gateway (WhatsApp Baileys)
# El brain debe estar levantado antes que el gateway
After=network-online.target sdk-bot-brain.service
Wants=network-online.target sdk-bot-brain.service

[Service]
Type=simple
WorkingDirectory=/home/zrx1/playground/sdk-bot/gateway
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
# Zona horaria fija del bot: America/Santiago (Chile). El sistema tiene
# /etc/localtime apuntando a Santiago pero /etc/timezone en UTC, lo que hace
# que Python/Node resuelvan UTC. Fijamos TZ para que los logs y la hora que
# usa el bot sean siempre Chile, independiente del server.
Environment=TZ=America/Santiago
# F4-P6: broadcasts APAGADOS por defecto (kill-switch). El admin los enciende con /broadcast on.
# Puertos DEV (rango playground, NO prod): ver playground/PORT_ALLOCATION.sdk-bot.md
#   ADMIN_WEB_PORT=5201  (panel web, rango dev bridge 5200-5299)
#   STATUS_PORT=5300     (status server, rango dev misc 5300-5399)
#   BRAIN_API_BASE       (FastAPI del brain en :5100, rango dev backend 5100-5199)
#   ADMIN_WEB_HOST/STATUS_HOST=0.0.0.0 -> el tailnet (Tailscale) alcanza el panel
#     desde el PC de pruebas remoto. La seguridad la da Tailscale (solo tu tailnet).
Environment=SDK_ADMIN_WEB_ENABLED=1
Environment=ADMIN_WEB_PORT=5201
Environment=STATUS_PORT=5300
Environment=BRAIN_API_BASE=http://127.0.0.1:5100
Environment=ADMIN_WEB_HOST=0.0.0.0
Environment=STATUS_HOST=0.0.0.0

[Install]
WantedBy=default.target
