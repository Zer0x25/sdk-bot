# systemd USER-unit del Brain (FastAPI) — estándar homelab (systemd --user)
# Instalación:
#   cp sdk-bot-brain.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now sdk-bot-brain
# (Sin sudo: todo el homelab corre en systemd --user + linger del usuario zrx1)

[Unit]
Description=SDK-Bot Brain (FastAPI - cascadea Groq/OpenRouter/Gemini)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/zrx1/playground/sdk-bot/brain
# ⚠️ Ajusta la ruta del venv de Python a tu instalación
ExecStart=/home/zrx1/playground/sdk-bot/brain/venv/bin/python main.py
Restart=always
RestartSec=5
# 2s más que el timeout de la cascada de proveedores (90s) + margen de finalización de envíos
TimeoutStopSec=120
KillSignal=SIGTERM
# Cree el proceso por defecto con locales UTF-8
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
# Puerto DEV (rango playground): 5100 (backend 5100-5199). Ver playground/PORT_ALLOCATION.sdk-bot.md
Environment=BRAIN_PORT=5100
# DEV remoto: bind 0.0.0.0 para que el tailnet (Tailscale) alcance el brain desde
# el PC de pruebas. La seguridad la da Tailscale (solo tu tailnet entra a la VM).
Environment=BRAIN_HOST=0.0.0.0

[Install]
WantedBy=default.target
