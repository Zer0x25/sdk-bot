# systemd USER-unit legacy del Panel Web (3er proceso, independiente del gateway).
# La producción documentada usa Docker Compose.
# Estándar homelab (systemd --user, sin sudo).
# Instalación:
#   cp sdk-bot-panel.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now sdk-bot-panel
#
# El panel consume el bus interno del gateway (127.0.0.1:5400) por HTTP.
# Es un proceso aparte: si el gateway cae, el panel sigue vivo y el front
# se reconecta solo cuando el gateway (y su bus) vuelve.

[Unit]
Description=SDK-Bot Panel Web (administración, proceso independiente)
After=network-online.target sdk-bot-gateway.service
Wants=network-online.target sdk-bot-gateway.service

[Service]
Type=simple
WorkingDirectory=/home/zrx1/playground/sdk-bot/gateway/panel
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=TZ=America/Santiago
Environment=ADMIN_WEB_PORT=5201
Environment=ADMIN_WEB_HOST=0.0.0.0
Environment=GATEWAY_INTERNAL_URL=http://127.0.0.1:5400

[Install]
WantedBy=default.target
