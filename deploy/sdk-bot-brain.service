# systemd unit del Brain (FastAPI, puerto 8000)
# Instalación:
#   sudo cp sdk-bot-brain.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sdk-bot-brain
# Ajusta User/Group y WorkingDirectory/ExecStart a tu ruta real.

[Unit]
Description=SDK-Bot Brain (FastAPI - cascadea Groq/OpenRouter/Gemini)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zrx1
Group=zrx1
WorkingDirectory=/home/zrx1/playground/SDK-bot/brain
# ⚠️ Ajusta la ruta del venv de Python a tu instalación
ExecStart=/home/zrx1/playground/SDK-bot/brain/venv/bin/python main.py
Restart=always
RestartSec=5
# 2s más que el timeout de la cascada de proveedores (90s) + margen de finalización de envíos
TimeoutStopSec=120
KillSignal=SIGTERM
# Cree el proceso por defecto con locales UTF-8
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8

[Install]
WantedBy=multi-user.target
